# ============================================================
# Eduino_PostPilot - 환경변수 템플릿
# ============================================================
# 사용법:
#   1) 이 파일을 복사해서 같은 폴더에 ".env" 로 저장
#        (cmd) copy .env.example .env
#   2) 아래 값들을 실제 값으로 채우기
#   3) .env 는 절대 git에 올리지 말 것 (.gitignore에 이미 등록됨)
# ============================================================

# --- OpenAI ---
# API 키 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-여기에_실제_키_입력

# 사용할 모델 (기본 권장: gpt-5.4)
# 정확한 모델 슬러그는 https://platform.openai.com/docs/models 에서 확인
OPENAI_MODEL=gpt-5.4

# --- 경로 ---
# 상세페이지 통이미지 루트 폴더 (선택)
#   - 비워두면 프로젝트 루트의 Product_eduino 폴더를 자동으로 사용합니다(권장).
#   - 다른 위치를 쓸 때만 경로를 넣으세요. ⚠ 'PRODUCTS_ROOT=' 는 한 번만!
# 예: PRODUCTS_ROOT=C:\edu-blog\products
PRODUCTS_ROOT=

# ============================================================
# 자동 수집 (Cafe24 스토어프론트 크롤링) — 선택, 기본값으로도 동작
# ============================================================
# 크롤링 대상 쇼핑몰 (자사몰). 기본: https://eduino.cafe24.com
SHOP_BASE=https://eduino.cafe24.com
# 요청 간 대기(초). 서버 부하/차단 방지용. 낮추지 마세요.
CRAWL_DELAY_SEC=2.0
# 상품 1개당 내려받을 상세이미지 최대 장수
CRAWL_MAX_IMAGES=25