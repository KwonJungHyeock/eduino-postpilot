# ============================================================
# Eduino_PostPilot - 환경변수 템플릿
# ============================================================
# 사용법:
#   1) 이 파일을 복사해서 같은 폴더에 ".env" 로 저장
#        (cmd) copy .env.example .env
#   2) 아래 값들을 실제 값으로 채우기
#   3) .env 는 절대 git에 올리지 말 것 (.gitignore에 이미 등록됨)
# ============================================================

# --- OpenAI ---
# API 키 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-여기에_실제_키_입력

# 사용할 모델 (기본 권장: gpt-5.4)
# 정확한 모델 슬러그는 https://platform.openai.com/docs/models 에서 확인
OPENAI_MODEL=gpt-5.4

# --- 경로 ---
# 상세페이지 통이미지 루트 폴더
# 이 폴더 안에 "제품코드_제품명" 폴더들이 들어있고, 각 폴더에 통이미지 1장
# 예: C:\edu-blog\products\EDU-UNO-001_초음파센서키트\detail.jpg
PRODUCTS_ROOT=PRODUCTS_ROOT=C:\Users\USER\Desktop\KwonJungHyeock\1_Project_dev\Eduino_PostPilot\Product_eduino